# Power Tracks Research defaults

# Path to a small price path CSV for the demo (keep rows small for speed)
# Prefer a micro slice you build yourself:
POWER_TRACKS_PRICE_PATHS=data/samples/micro/price_paths.csv

# Rows to read from the demo CSV
POWER_TRACKS_SAMPLE_ROWS=800

# API keys. Needed to fetch fresh samples.
POLYGON_API_KEY=

# Optional: where larger private data lives (not in git)
# POWER_TRACKS_DATA_DIR=../power-tracks-data
